# Build artifacts
/target
/dist
/fuzz/target
/fuzz/corpus
/fuzz/artifacts

# Live data — never commit business state or secrets
/data
/backups
*.db
.env
.env.*
!.env.example

# Local agent tooling — internal workflow, not published. EXCEPTION: the
# agent charters under agents/ ARE published — verify-agent-tiers.py (part
# of `make test`) machine-checks the ladder against them, so they travel
# with the repo.
/.opencode/*
!/.opencode/agents
/.commandcode
/.mimosa

# Vendored dependency sources — only the PATCHED crates are tracked (see
# [patch.crates-io] in Cargo.toml: the teloxide fork strips aquamarine and
# with it the unmaintained proc-macro-error2 from the dependency graph).
# Everything else a future `cargo vendor` run drops here stays untracked.
/vendor/*
!/vendor/teloxide/
/vendor/teloxide/target/
/vendor/teloxide/Cargo.lock

# Release bundles — binaries ship as GitHub Releases, not in the tree
/telegram-agent-*/

# OS noise
.DS_Store
Thumbs.db
