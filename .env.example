# Note: variables already set in the real environment win over this file
# (standard dotenv behavior). Systemd/desktop launches have a clean env,
# so this file is authoritative there.
# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Your Telegram user id (owner). Get it via @userinfobot (required)
OWNER_ID=

# SQLite database path
DATABASE_URL=sqlite:./data/agent.db

# Logging
RUST_LOG=info

# Optional: target channel default (can also set via web setup)
DEFAULT_CHANNEL=

# Optional: Crypto Pay API token from @CryptoBot -> Crypto Pay -> Create App
CRYPTO_PAY_TOKEN=

# Web dashboard
WEB_PORT=8080
# Bind address. 127.0.0.1 (default) keeps the dashboard local — right for
# desktop use. Servers/Docker should set 0.0.0.0 behind a TLS proxy.
WEB_BIND=127.0.0.1
# Open the dashboard in the system browser at startup
# (default: auto on Windows/macOS, off on Linux)
#OPEN_BROWSER=1
WEB_USERNAME=owner
WEB_PASSWORD=

# Optional: custom data directory (default: ./data in portable mode, else the
# platform dir — see docs/DESKTOP.md)
#DATABASE_DIR=

# Optional webhook mode (leave empty for long polling)
WEBHOOK_URL=
WEBHOOK_PORT=8443

# Optional: MCP server for AI agents (Model Context Protocol).
# Empty/unset = endpoint disabled entirely (secure default OFF).
# The token maps to the OWNER principal: read tools + publishing run
# directly; sensitive tools (gen_codes, delete_post, broadcast) always
# require your approval via /approve <id> in the bot.
MCP_OWNER_TOKEN=
